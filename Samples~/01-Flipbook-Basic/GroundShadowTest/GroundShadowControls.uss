.controls {
    align-self: stretch;
    margin: 10px 12px;
    padding: 7px 12px;
    color: rgb(234, 237, 240);
    background-color: rgb(32, 40, 51);
    border-radius: 6px;
    font-size: 14px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.toolbar {
    flex-wrap: wrap;
}

.title {
    margin-right: 20px;
    font-size: 16px;
    -unity-font-style: bold;
}

.count-label {
    margin-right: 6px;
}

.count {
    width: 76px;
    margin-right: 5px;
}

.count .unity-base-field__input {
    min-height: 28px;
    padding: 2px 7px;
    color: rgb(247, 248, 250);
    background-color: rgb(57, 69, 84);
    border-color: rgb(105, 122, 141);
    border-radius: 4px;
}

.row .unity-button {
    height: 28px;
    margin: 2px;
    padding: 2px 10px;
    border-width: 0;
    border-radius: 4px;
    color: rgb(234, 237, 240);
    background-color: rgb(57, 69, 84);
}

.row .unity-button:hover {
    background-color: rgb(70, 86, 105);
}

.row .apply {
    color: rgb(13, 39, 47);
    background-color: rgb(128, 213, 206);
}

.row .apply:hover {
    background-color: rgb(160, 232, 225);
}

.presets {
    margin-left: 12px;
    margin-right: 12px;
}

.presets .unity-button {
    min-width: 51px;
}

.toggles .unity-base-field__label {
    min-width: 0;
    margin-right: 6px;
    color: rgb(234, 237, 240);
}

.toggles .unity-button {
    margin-left: 10px;
}

.metrics {
    min-height: 21px;
    margin-top: 3px;
    flex-wrap: wrap;
}

.frame-rate {
    margin-right: 16px;
    color: rgb(159, 226, 220);
    -unity-font-style: bold;
}

.render-stats {
    color: rgb(201, 209, 219);
    font-size: 13px;
}
